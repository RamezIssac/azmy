SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — leave POSTGRES_DB blank to use SQLite locally
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis — set in production (rambo writes it). Blank locally = extraction runs sync.
REDIS_URL=

# Storage — defaults are fine locally; rambo sets absolute paths in production
STATIC_ROOT=
MEDIA_ROOT=
PRIVATE_ROOT=

# OpenRouter — per-task model routing (free-tier defaults; see docs/phase-2-design.md)
OPENROUTER_API_KEY=
OPENROUTER_MODEL_METADATA=qwen/qwen3.8-27b:free,google/gemini-2.5-flash
OPENROUTER_MODEL_STRUCTURE=qwen/qwen3.8-27b:free,google/gemini-2.5-flash
OPENROUTER_MODEL_OCR=google/gemma-4-31b-it:free,google/gemini-2.5-flash
OPENROUTER_MODEL_JUDGE=qwen/qwen3.8-27b:free,google/gemini-2.5-flash

# Email — leave blank to use console backend
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_SSL=True
DEFAULT_FROM_EMAIL=noreply@azmy.raenterprises.de

ACCOUNT_HTTP_PROTOCOL=http
ACCOUNT_EMAIL_VERIFICATION=optional
