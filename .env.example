SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — leave POSTGRES_DB blank to use SQLite locally
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis — set in production (rambo writes it). Blank locally = extraction runs sync.
REDIS_URL=

# Storage — defaults are fine locally; rambo sets absolute paths in production
STATIC_ROOT=
MEDIA_ROOT=
PRIVATE_ROOT=

# OpenRouter (LLM structuring / judge)
OPENROUTER_API_KEY=
OPENROUTER_MODEL_METADATA=google/gemini-2.5-flash
OPENROUTER_MODEL_STRUCTURE=google/gemini-2.5-flash
OPENROUTER_MODEL_JUDGE=anthropic/claude-sonnet-4.5

# Email — leave blank to use console backend
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_SSL=True
DEFAULT_FROM_EMAIL=noreply@azmy.raenterprises.de

ACCOUNT_HTTP_PROTOCOL=http
ACCOUNT_EMAIL_VERIFICATION=optional
